# Pick ONE provider. The pipeline auto-detects whichever key is present.
# Free tier, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Free tier alternative: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Cache-only mode: replay committed LLM cache, never call the network.
# Lets a reviewer reproduce headline numbers with no API key at all.
LLM_OFFLINE=0
